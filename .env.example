# 伺服器埠號
PORT=3000

# 後台初始管理員帳密（正式環境務必改掉；沒設定時程式會退回 admin / changeme，不安全）
ADMIN_USER=admin
ADMIN_PASSWORD=請改成你自己的密碼

# session 簽章密鑰（正式環境務必設定一長串隨機字串；沒設定時會退回寫死的預設值）
SESSION_SECRET=請改成一長串隨機字串

# 資料庫檔案位置（部署到 Railway 時指向掛載的 Volume，例如 /data/survey.db）
DB_PATH=./survey.db

# 寄信（Resend）。不設定 RESEND_API_KEY 或 NOTIFY_EMAIL_TO 則不寄通知信
RESEND_API_KEY=
# 新填寫通知收件者，多人用逗號分隔
NOTIFY_EMAIL_TO=
# 寄件人；沒設定時會用 onboarding@resend.dev（僅供測試）
NOTIFY_EMAIL_FROM=

# 彙總儀表板（tnh-hub）讀取計數用的金鑰（Bearer token）。沒設定時 /api/metrics 會拒絕所有請求
METRICS_TOKEN=

# 邀請信內的問卷網址（也供 npm run qrcode 使用）
SURVEY_URL=http://localhost:3000
